# Django Settings
SECRET_KEY=generate-a-strong-random-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com
SECURE_SSL_REDIRECT=True

# Field Encryption Key (Optional; if unset, derives from SECRET_KEY)
FIELD_ENCRYPTION_KEY=

# Default AI Provider (auto, gemini, openai, claude, deepseek, free, mock)
DEFAULT_AI_PROVIDER=auto

# Force Mock Provider for offline testing / zero network calls (True/False)
USE_MOCK_LLM=False

# API Keys for Commercial LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# LLM Purpose Routing Table (JSON mapping or standard defaults)
# Purposes: chat, completeness, srs, plan, codegen, repair, summary
DEFAULT_CHAT_MODEL=gemini-2.0-flash
DEFAULT_CODEGEN_MODEL=qwen-2.5-coder

# LLM Call Logging Settings
LLM_LOG_BODIES=False

# System Thresholds & Feature Flags
COMPLETENESS_THRESHOLD=70
RUNTIME_CHECKS_ENABLED=False

# Email SMTP Settings (For OTP Authentication)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@devdialogue.ai
